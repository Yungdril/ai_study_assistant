# Groq API key (server-side only — never expose this to the frontend)
GROQ_API_KEY=your_groq_api_key_here

# Port the Express server listens on
PORT=5000

# URL this server pings every 14 minutes to prevent Render free-tier sleep.
# Set to your deployed backend URL.
SELF_URL=https://smartpal.onrender.com

QUIZ_MODEL=gemini-3.8-flash
QUIZ_API_KEY=your_gemini_api_key_here


# OpenAI API key for PDF summaries (backend only)
OPENAI_API_KEY=your_openai_api_key_here
PDF_MODEL=gpt-4.1-mini
